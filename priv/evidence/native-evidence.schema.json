{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pcharbon70/vfp_mcp/raw/main/priv/evidence/native-evidence.schema.json",
  "title": "VFP MCP native evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "scenario_id",
    "vfp_version",
    "ide_version",
    "operator",
    "recorded_at",
    "outcome",
    "source_pair",
    "actions",
    "observations",
    "signoff_file"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "evidence_id": { "type": "string", "minLength": 1 },
    "scenario_id": {
      "enum": ["fixture_authoring", "property_edit", "method_edit"]
    },
    "vfp_version": { "enum": [6, 9] },
    "ide_version": { "type": "string", "minLength": 1 },
    "operator": { "type": "string", "minLength": 1 },
    "recorded_at": { "type": "string", "format": "date-time" },
    "outcome": { "enum": ["pass", "fail"] },
    "source_pair": { "$ref": "#/$defs/pair" },
    "result_pair": {
      "oneOf": [
        { "$ref": "#/$defs/pair" },
        { "type": "null" }
      ]
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/action" }
    },
    "observations": { "type": "object" },
    "signoff_file": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256", "bytes"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "pair_sha256", "dbf", "fpt"],
      "properties": {
        "kind": { "enum": ["scx", "vcx"] },
        "pair_sha256": { "$ref": "#/$defs/sha256" },
        "dbf": { "$ref": "#/$defs/artifact" },
        "fpt": { "$ref": "#/$defs/artifact" }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "outcome", "observation"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "outcome": { "enum": ["pass", "fail"] },
        "observation": { "type": "string", "minLength": 1 }
      }
    }
  }
}
